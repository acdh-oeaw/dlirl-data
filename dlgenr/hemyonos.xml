                  <quote>mule</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>ἡμίονος</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>[ואלה בני צבעון ואיה וענה] וגו' תני האש והכלאים לא נבראו בששת ימי בראשית אבל עלו במחשבה להבראות, כלאים אימתי נבראו, בימי ענה הה"ד הוא ענה אשר מצא את הימים במדבר, ר' סימון אמר 
                     <app>
                        <lem>המיונים</lem>
                        <rdg wit="#Vat2">במיונם</rdg>
                        <rdg wit="#K V Ox1 Ox2">המיונס</rdg>
                     </app>, רבנין אמ' הימיסו</quote>
                  <bibl>
                     <ref type="witness">82,14</ref>
                     <ref type="witness">II 994: 1</ref>
                  </bibl>
                  <ref type="entry" xml:lang="jpa" target="hemisu.html">הימיסו</ref>
                  <note>= <bibl type="ancient">yBer 8,5 [62: 37]</bibl> (<term xml:lang="jpa">היימים</term>)</note>
               </cit>
            </sense>
            <note>Cf. <bibl type="modern">Jastrow I 347a</bibl>.</note>
