      <body>
         <entry xml:id="basileos-dlgenr"
            xml:lang="en"
            type="mainEntry"
            prev="#"
            next="#"
            source="Genesis Rabbah">
            <form type="lemma" opt="false">
               <orth type="lemma" xml:lang="jpa" opt="false" select="true">בסיליוס</orth>
               <orth type="transliteration" xml:lang="fjb" opt="false">bsylyws</orth>
               <pron notation="rabbinic">basileos</pron>
               <gramGrp>
                  <gram type="pos">noun</gram>
                  <gram type="gen">m.</gram>
               </gramGrp>
            </form>
            <sense xml:id="basilios-dlgenr-1">
               <cit type="translation" xml:lang="en" subtype="sense">
                  <quote>king</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>βασιλεύς</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>ועתה לא אתם שלחתם אתי הנה כי האלהים וישימני לאב 
                     <app>
                        <lem>לפטרון בסיליוס</lem>
                        <rdg wit="#K">לפטרובסיליאוס מלכות</rdg>
                        <rdg wit="#V">לפטרון בסיליון</rdg>
                     </app> לאדון לריבון, ומושל שליט</quote>
                  <bibl>
                     <ref type="witness">93,9</ref>
                     <ref type="witness">III 1160: 7</ref>
                  </bibl>
                  <ref type="entry" xml:lang="jpa">פטרון</ref>
                  <cit type="translation" xml:lang="en">
                     <quote>And now, it was not you who sent me here, but God; he has made me a father (Gen 45,8) - a patron of the king, a Lord - an official, and ruler - a governor.</quote>
                  </cit>
                  <note>= <bibl type="ancient">Yalq 157 [50a: 25]</bibl> (<term xml:lang="jpa">בסיליוש</term>)</note>
               </cit>
            </sense>
            <note>Cf. <bibl type="modern">Krauss, LW II 161ab</bibl>.</note>
            <ref type="bibliography">
               <bibl>
                  <title>Sokoloff, DJPA</title>
                  <citedRange>91b</citedRange>
               </bibl>
            </ref>
         </entry>
