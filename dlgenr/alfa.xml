      <body>
         <entry xml:id="alfa-dlgenr"
            xml:lang="en"
            type="mainEntry"
            prev="#"
            next="#"
            source="Genesis Rabbah">
            <form type="lemma" opt="false">
               <orth type="lemma" xml:lang="jpa" opt="false" select="true">אלפא</orth>
               <orth type="transliteration" xml:lang="fjb" opt="false">ʾlpʾ</orth>
               <pron notation="rabbinic">alfaʾ</pron>
               <gramGrp>
                  <gram type="pos">noun</gram>
                  <gram type="gen">m.</gram>
               </gramGrp>
            </form>
            <sense xml:id="alfa-dlgenr-1">
               <cit type="translation" xml:lang="jpa" subtype="sense">
                  <quote>Alpha [the letter], first, superb, best quality</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>ἄλφα</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>אדם אחד מאלף מצאתי כהדה דתנינן אלפא ליין</quote>
                  <bibl>
                     <ref type="witness">28,4</ref>
                     <ref type="witness">I 262: 8</ref>
                  </bibl>
                  <cit type="translation" xml:lang="en">
                     <quote>One man among a thousand (elef) have I found (Koh 7,28) as when we learned, Best quality (“alfaʾ”) wine … (Freedman / Simon I 225)</quote>
                  </cit>
                  <note>= <bibl type="ancient">mMen 8,6</bibl></note>
               </cit>
            </sense>
            <ref type="bibliography">
               <bibl>
                  <title>Heijmanns (2014)</title>
                  <citedRange>35-36</citedRange>
               </bibl>
            </ref>
         </entry>
