  <text>
      <body>
         <entry xml:id="qartal-dlgenr"
            xml:lang="en"
            type="mainEntry"
            prev="#"
            next="#"
            source="Genesis Rabbah">
            <form type="lemma" opt="false">
               <orth type="lemma" xml:lang="jpa" opt="false" select="true">קרטל</orth>
               <orth type="transliteration" xml:lang="fjb" opt="false">qrṭl</orth>
               <pron notation="rabbinic" opt="false">qarṭal</pron>
               <gramGrp opt="false">
                  <gram type="pos" opt="false">noun</gram>
                  <gram type="gen">m.</gram>
               </gramGrp>
               <form type="variant">
                  <orth type="variant" xml:lang="jpa">קרטלא</orth>
                  <orth type="transliteration" xml:lang="fjb">qrṭlʾ</orth>
                  <pron notation="rabbinic">qarṭala</pron>
               </form>
               <form type="variant">
                  <orth type="variant" xml:lang="jpa">קרסטל</orth>
                  <orth type="transliteration" xml:lang="fjb">qrsṭl</orth>
                  <pron notation="rabbinic">qarasṭal</pron>
               </form>
            </form>
            <sense xml:id="qartal-dlgenr-1">
               <cit type="translation" xml:lang="jpa" subtype="sense">
                  <quote>basket</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>κάρταλος</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>ר' ירמיה שלח לר' זעירא חד 
                     <app>
                        <lem>קרסטל</lem>
                        <rdg wit="#Vat1">קרטל</rdg>
                        <rdg wit="#V">קרטיל</rdg>
                        <rdg wit="#Ox2">קרסתל</rdg>
                     </app> דתאנים</quote>
                  <bibl>
                     <ref type="witness">60,8</ref>
                     <ref type="witness">II 649: 4</ref>
                  </bibl>
                  <cit type="translation" xml:lang="en">
                     <quote>R. Yirmeyah sent R. Zeʿira a basket of figs.</quote>
                  </cit>
                  <note>= <bibl type="ancient">Yalq 109 [II 488: 35]</bibl> (<term xml:lang="jpa">טרסקל</term>)</note>
               </cit>
            </sense>
            <note>Attested also in <bibl type="ancient">LevR 25,5</bibl>; <bibl type="ancient">tShab 4,5 [II 17:13]</bibl> – <term xml:lang="jpa">קרטלין</term>, var. <term xml:lang="jpa">קרסטלין</term>; <bibl type="ancient">KοhR 2,20 [8c]</bibl> and other. Cf. <bibl type="modern">AC VII 194b</bibl>; <bibl type="modern">Levy IV 376a</bibl>; <bibl type="modern">Fürst (1890) 20a</bibl>; <bibl type="modern">Jastrow II 1417a</bibl> (“prob. of Semitic origin”). Syr. <term xml:lang="syc">ܩܪܛܠܐ</term> <term xml:lang="fjb">qrṭlʾ</term>, <bibl type="modern">Sokoloff, SL 1406a</bibl>.</note>
            <ref type="bibliography">
               <bibl>
                  <title>Sokoloff, DJPA</title>
                  <citedRange>576b</citedRange>
               </bibl>
               <bibl>
                  <title>Krauss, LW II</title>
                  <citedRange>567b; 569b-570a</citedRange>
               </bibl>
            </ref>
         </entry>
      </body>
