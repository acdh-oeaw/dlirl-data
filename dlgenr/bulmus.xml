  <text>
      <body>
         <entry xml:id="bulmus-dlgenr"
            xml:lang="en"
            type="mainEntry"
            prev="#"
            next="#"
            source="Genesis Rabbah">
            <form type="lemma" opt="false">
               <orth type="lemma" xml:lang="jpa" opt="false" select="true">בולמוס</orth>
               <orth type="transliteration" xml:lang="fjb" opt="false">bwlmws</orth>
               <pron notation="rabbinic">bulmus</pron>
               <gramGrp>
                  <gram type="pos">noun</gram>
                  <gram type="gen">m.</gram>
               </gramGrp>
            </form>
            <sense xml:id="bulmus-dlgenr-1">
               <cit type="translation" xml:lang="en" subtype="sense">
                  <quote>ravenous hunger, faintness from hunger, fig. sexual passion</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>βούλιμος</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>אמר ר' נחמן בר חנן כל מי שלהוט אחר בולמוס העריות סוף שמאכילים אותו מבשרו</quote>
                  <bibl>
                     <ref type="witness">40 (41),7</ref>
                     <ref type="witness">I 393: 11</ref>
                  </bibl>
                  <cit type="translation" xml:lang="en">
                     <quote>R. Naḥman bar Ḥanan said: Whoever has forbidden sexual passion will be eventually fed with his own flesh.</quote>
                  </cit>
                  <note>= 51,10 [II 539: 1]; <bibl type="ancient">Tanh Wa-yeraʾ 12</bibl>; <bibl type="ancient">SekhT Wa-yeraʾ 19,33</bibl>; <bibl type="ancient">Yalq 70 [19b: 38]</bibl>; <bibl type="ancient">Yalq 86 [26c: 44]</bibl></note>
               </cit>
            </sense>
            <note>Already in <bibl type="ancient">mYom 8,6</bibl>. <bibl type="modern">Krauss, LW II 141a</bibl>. Syr. <term xml:lang="syc">ܒܘܠܝܡܘܣ</term> <term xml:lang="fjb">bwlymws</term> see <bibl type="modern">Sokoloff, SL 127a</bibl>.</note>
            <ref type="bibliography">
               <bibl>
                  <title>Heijmanns (2013)</title>
                  <citedRange>64-65</citedRange></bibl>
            </ref>
         </entry>
