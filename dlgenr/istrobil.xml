            <sense xml:id="istrobil-dlgenr-1">
               <cit type="translation" xml:lang="en" subtype="sense">
                  <quote>the lower millstone, the bedstone</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>στρόβιλος</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>ר' לוי בשם ר' יוחנן [אפילו 
                     <app>
                        <lem>איסטרובילין</lem>
                        <rdg wit="#V">אסטרובילין</rdg>
                        <rdg wit="#K">אצטרובילין</rdg>
                        <rdg wit="#Vat1">איסרובלין</rdg>
                        <rdg wit="#Ox1">איצטרובילין</rdg>
                        <rdg wit="#Ox2">אצטרובילין</rdg>
                     </app> שלרחים נמחה ...]</quote>
                  <bibl>
                     <ref type="witness">25,3</ref>
                     <ref type="witness">I 261: 3</ref>
                  </bibl>
                  <cit type="translation" xml:lang="en">
                     <quote>R. Lewi said in the name of R. Yoḥanan: Even the bedstone of a millstone has been destroyed ...</quote>
                  </cit>
                  <note>= <bibl type="ancient">LevR 31,10</bibl>; <bibl type="ancient">Yalq 47 [13b: 41]</bibl> (<term xml:lang="jpa">אצטרובולין</term>); <bibl type="ancient">CantR 1,4</bibl> (<term xml:lang="jpa">אצטרבולין</term>)</note>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>דאמר ר' לוי מש' ר' יוחנן אפילו 
                     <app>
                        <lem>איסטרובילין</lem>
                        <rdg wit="#V Ox2">איצטרובילין</rdg>
                        <rdg wit="#K">אצטרבילין</rdg>
                     </app> שלרחים נימחא במים</quote>
                  <bibl>
                     <ref type="witness">30,8</ref>
                     <ref type="witness">I 274: 7</ref>
                  </bibl>
                  <cit type="translation" xml:lang="en">
                     <quote>R. Lewi said in the name of R. Yoḥanan: Even the bedstone of a millstone has been destroyed by water.</quote>
                  </cit>
                  <note>= <bibl type="ancient">LevR 31,10</bibl>; <bibl type="ancient">Yalq 47 [13b: 41]</bibl> (<term xml:lang="jpa">אצטרובולין</term>); <bibl type="ancient">CantR 1,4</bibl> (<term xml:lang="jpa">אצטרבולין</term>)</note>
               </cit>
            </sense>
            <note>Cf. <bibl type="modern">AC 173b-174a</bibl>; <bibl type="modern">Levy I 121 ab</bibl>; <bibl type="modern">Jastrow I 55b</bibl>; <bibl type="modern">Krauss, LW II 121ab</bibl>; <bibl type="modern">Sokoloff, DJBA 125ab</bibl>. Sg. not attested in GenR. The second meaning “pine nut” is not attested in GenR.</note>
            <ref type="bibliography">
               <bibl>
                  <title>Heijmann (2013)</title>
                  <citedRange>30-31</citedRange>
               </bibl>
            </ref>
