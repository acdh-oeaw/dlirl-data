            <sense xml:id="istratiot-dlgenr-1">
               <cit type="translation" xml:lang="en" subtype="sense">
                  <quote>soldier</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>στρατιώοτης</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>שני תלמידים משל ר' יהושע שינו עטיפתם בשעת השמד, פגע בהם 
                     <app>
                        <lem>איסטרטיוט</lem>
                        <rdg wit="#Ox1 Ox2">איסטרטוס</rdg>
                        <rdg wit="#K V">סרדיוט</rdg>
                     </app> אחד משומד</quote>
                  <bibl>
                     <ref type="witness">82,8</ref>
                     <ref type="witness">I 985: 1</ref>
                  </bibl>
                  <cit type="translation" xml:lang="en">
                     <quote>Two disciples of R. Yehoshua changed their cloaks at the time of persecution. A certain [Roman] officer, an apostate, met them ... [Freedman / Simon II 757-758]</quote>
                  </cit>
                  <note>= <bibl type="ancient">Yalq 136 [II 700: 15]</bibl> (<ref type="entry" xml:lang="jpa">איסטרטיגוס</ref>); <bibl type="ancient">Yalq Jes 396 [XI 31: 2]</bibl></note>
               </cit>
            </sense>
            <note>Pl. not in GenR. Cf. Syr <term xml:lang="syc">ܐܣܛܪܛܝܘܛܐ</term> <term xml:lang="fjb">ʾsṭrṭywṭʾ</term> see <bibl type="modern">Sokoloff, SL 71b</bibl>.</note>
