      <body>
         <entry xml:id="arkhiqrites-dlgenr"
            xml:lang="en"
            type="mainEntry"
            prev="#"
            next="#"
            source="Genesis Rabbah">
            <form type="lemma" opt="false">
               <orth type="lemma" xml:lang="jpa" opt="false" select="true">ארכיקריטיס</orth>
               <orth type="transliteration" xml:lang="fjb" opt="false">ʾrkyqryṭys</orth>
               <pron notation="rabbinic">arkhiqriṭes</pron>
               <gramGrp>
                  <gram type="pos">noun</gram>
                  <gram type="gen">m.</gram>
               </gramGrp>
            </form>
            <sense xml:id="arkhiqrites-dlgenr-1">
               <cit type="translation" xml:lang="en" subtype="sense">
                  <quote>chief judge</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>ἀρχικρίτης</quote>
               </cit>
               <cit type="example" xml:lang="grc">
                  <quote>ולוט היה 
                     <app>
                        <lem>ארכיקריטיס</lem>
                        <rdg wit="#Vat1">ארכי דיינים</rdg>
                        <rdg wit="#K V">ארכי הדיינים</rdg>
                        <rdg wit="#Vat2">ארכי דיינין</rdg>
                     </app> שלהם</quote>
                  <bibl>
                     <ref type="witness">50,3</ref>
                     <ref type="witness">II 519: 5</ref>
                  </bibl>
                  <cit type="translation" xml:lang="en">
                     <quote>Lot was their chief judge.</quote>
                  </cit>
                  <note>= <bibl type="ancient">Yalq 84 [26a: 46]</bibl> (<term xml:lang="jpa">ארכי הדיינין</term>); <bibl type="ancient">SekhṬ 19,1 [32]</bibl> (<term xml:lang="jpa">ערכי הדיינין</term>)</note>
               </cit>
            </sense>
            <note><bibl type="modern">Krauss, LW II 130a; 568a</bibl>. Aruch has: <term xml:lang="jpa">ארכי קריטיס</term> <term xml:lang="fjb">ʾrky qryṭys</term>.</note>
            <ref type="bibliography">
               <bibl>
                  <title>Sperber (1984)</title>
                  <citedRange>67</citedRange>
               </bibl>
            </ref>
         </entry>
