            <form type="lemma" opt="false">
               <orth type="lemma" xml:lang="jpa" opt="false" select="true">ביזייה</orth>
               <orth type="transliteration" xml:lang="fjb" opt="false">byzyyh</orth>
               <pron notation="rabbinic">byziyyah</pron>
               <gramGrp>
                  <gram type="pos">noun</gram>
                  <gram type="gen">f.</gram>
               </gramGrp>
            </form>
            <sense xml:id="biziyyah-dlgenr-1">
               <cit type="translation" xml:lang="en" subtype="sense">
                  <quote>disk</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="la">
                  <lbl>Ital.</lbl>
                  <quote>vassojo</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>ביזייה דיסקוס נאה</quote>
                  <bibl>
                     <ref type="witness">34,9</ref>
                     <ref type="witness">I 319:4</ref>
                  </bibl>
                  <ref type="entry" xml:lang="jpa" target="disqos.html">דיסקוס</ref>
                  <cit type="translation">
                     <quote>A beautiful gift, a beautiful plate.</quote>
                  </cit>
               </cit>
            </sense>
            <note>Suggested by Löw (in MY ad loc). Probably, a later gloss. Cf. <ref type="entry" xml:lang="jpa" target="doron.html">דורון</ref>, <ref type="entry" xml:lang="jpa" target="disqos.html">דיסקוס</ref></note>
