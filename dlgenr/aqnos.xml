  <text>
      <body>
         <entry xml:id="aqnos-dlgenr"
            xml:lang="en"
            type="mainEntry"
            prev="#"
            next="#"
            source="Genesis Rabbah">
            <form type="lemma" opt="false">
               <orth type="lemma" xml:lang="jpa" opt="false" select="true">אקנוס</orth>
               <orth type="transliteration" xml:lang="fjb" opt="false">ʾqnws</orth>
               <pron notation="rabbinic">aqnos</pron>
               <gramGrp>
                  <gram type="pos">adjective</gram>
               </gramGrp>
            </form>
            <sense xml:id="aqnos-dlgenr-1">
               <cit type="translation" xml:lang="en" subtype="sense">
                  <quote>worthy, adequate</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>ἱκανός</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>תני מש' ר' אליעזר בן יעקב אני הוא שאין העולם ומלואו כדיי כאלהותי, תרגם עקילס אקסיוס 
                     <app>
                        <lem>ואיקנוס</lem>
                        <rdg wit="#K V">ואנקוס</rdg>
                        <rdg wit="#Ox1">ואנקינוס</rdg>
                     </app></quote>
                  <bibl>
                     <ref type="witness">46,3</ref>
                     <ref type="witness">I 461: 2</ref>
                  </bibl>
                  <ref type="entry" xml:lang="jpa">אקסיוס</ref>
                  <cit type="translation" xml:lang="en">
                     <quote>It was taught in the name of R. Eliʿezer v. Yaʿaqov: It is I whose Godhead outweighs the world and the fulness thereof. Aquila translated it: worthy and adequate. (cf. Freedman / Simon I 391)</quote>
                  </cit>
               </cit>
            </sense>
            <note>Cf. <bibl type="modern">Levy I 156a</bibl>. <term xml:lang="jpa">אקנוס</term> apparently same meaning as <ref type="entry" xml:lang="jpa">אקסיוס</ref>. <bibl type="ancient">MidrT 4,9 [24a]</bibl>: <term xml:lang="jpa">אונקים</term> <term xml:lang="fjb">ʾwnqym</term> corr. <term xml:lang="jpa">אינקוס</term> <term xml:lang="fjb">ʾynqws</term>; <bibl type="ancient">TanhB Mi-qeṣ 9 [97b]</bibl>: (<term xml:lang="jpa">אוקנוס פי</term>, <term xml:lang="jpa">אדם חכם</term>); <bibl type="ancien">Makh Mal 1,3</bibl> [<bibl type="modern">Ed. Greenup 9]</bibl>: <term xml:lang="jpa">אוקינוס</term> <term xml:lang="fjb">ʾwqynws</term>. See <bibl>Fränkel (1831) 28-29</bibl>; <bibl>Lerner (1882) 57-58</bibl>.</note>
            <ref type="bibliography">
               <bibl>
                  <title>Krauss, LW II</title>
                  <citedRange>124a</citedRange>
               </bibl>
            </ref>
         </entry>
