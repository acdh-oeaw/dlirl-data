  <text>
      <body>
         <entry xml:id="katla-dlgenr"
            xml:lang="en"
            type="mainEntry"
            prev="#"
            next="#"
            source="Genesis Rabbah">
            <form type="lemma" opt="false">
               <orth type="lemma" xml:lang="jpa" opt="false" select="true">קטלא</orth>
               <orth type="transliteration" xml:lang="fjb" opt="false">qṭlʾ</orth>
               <pron notation="rabbinic" opt="false">kaṭlaʾ</pron>
               <gramGrp opt="false">
                  <gram type="pos" opt="false">noun</gram>
                  <gram type="gen" opt="false">f.</gram>
               </gramGrp>
               <form type="variant">
                  <orth type="variant" xml:lang="jpa">קטלה</orth>
                  <orth type="transliteration" xml:lang="fjb" opt="false">qṭlh</orth>
                  <pron notation="rabbinic" opt="false">qaṭlah</pron>
               </form>
            </form>
            <form type="inflected">
               <orth type="inflected" xml:lang="jpa">קטליות</orth>
               <orth type="transliteration" xml:lang="fjb">qaṭliyot</orth>
               <gramGrp>
                  <gram type="num">pl.</gram>
               </gramGrp>
            </form>
            <form type="inflected">
               <orth type="inflected" xml:lang="jpa">קטלין</orth>
               <orth type="transliteration" xml:lang="fjb">qṭlyn</orth>
               <pron notation="rabbinic" opt="false">kaṭlin</pron>
               <gramGrp>
                  <gram type="num">pl.</gram>
               </gramGrp>
            </form>
            <sense xml:id="katla-dlgenr-1">
               <cit type="translation" xml:lang="en" subtype="sense">
                  <quote>necklet</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="grc">
                  <quote>κατέλλα</quote>
               </cit>
               <cit type="translationEquivalent" xml:lang="la">
                  <quote>catella</quote>
               </cit>
               <cit type="example" xml:lang="jpa">
                  <quote>בנות צעדה עלי שור וגו' את מוצא בשעה שיצא יוסף למלוך על מצריים, היו בנות מלכים מציצות עליו דרך החרכין והיו משליכות עליו שיירין 
                     <app>
                        <lem>וקטלין</lem>
                        <rdg wit="#Vat1">וקולין</rdg>
                     </app> ונזמים וטבעות כדי שיתלה עיניו ויביט בהן</quote>
                  <bibl>
                     <ref type="witness">98 [99],18</ref>
                     <ref type="witness">III 1268: 10</ref>
                  </bibl>
                  <cit type="translation" xml:lang="en">
                     <quote>The daughters run over the wall (Gen 49,22). You find that when Joseph went forth to rule over Egypt, daughters of kings used to look at him through lattices and throw bracelets, necklets, ear-rings, and finger-rings to him, so that he might lift up his eyes and look at them. (Freedman / Simon II 968)</quote>
                  </cit>
               </cit>
            </sense>
            <note>Sg. not in GenR. See also <bibl type="modern">Krauss, LW II 525b</bibl>. Common in Rabb. Lit.</note>
            <ref type="bibliography">
               <bibl>
                  <title>Heijmanns (2013)</title>
                  <citedRange>199-200</citedRange>
               </bibl>
            </ref>
         </entry>
